  "operations": {
    "observe-environment": {
      "file": "evals/growth/observe.mjs",
      "sha256": "1e0cf44d0fec69a3f6242333f065831ea69fa03035dace6e8cf6c2702aa9b595",
      "purposes": [
        "probe",
        "applicability",
        "use",
        "review"
      ],
      "description": "Read actual environment observations. JSON input is {\"kind\":\"git-status\",\"checkoutAutocrlf\":boolean,\"readerConfig\":\"inherit\" or \"sanitized\",\"newline\":\"LF\" or \"CRLF\"}, or {\"kind\":\"text-view\",\"content\":\"text data\",\"leftView\":\"raw\" or \"normalize-lf\",\"rightView\":\"raw\" or \"normalize-lf\"}. The operation returns actual Git status or independently read file view comparison. No executable code or path arguments are accepted."
    }
  },
  "applicabilityOperation": "observe-environment",
  "useOperation": "observe-environment",
  "reviewOperation": "observe-environment",
  "review": {
    "cases": [
      {
        "id": "final-git-filter",
        "description": "Determine whether Git will report the tracked file dirty using the given checkout and reader settings. Return exactly {\"dirty\":boolean}.",
        "environment": "git",
        "input": {
          "kind": "git-status",
          "checkoutAutocrlf": true,
          "readerConfig": "sanitized",
          "newline": "CRLF"
        },
        "expected": {
          "dirty": true
        },
        "split": "holdout"
      },
      {
        "id": "final-git-clean",
        "description": "Determine whether Git will report the tracked file dirty using the given checkout and reader settings. Return exactly {\"dirty\":boolean}.",
        "environment": "git",
        "input": {
          "kind": "git-status",
          "checkoutAutocrlf": false,
          "readerConfig": "inherit",
          "newline": "CRLF"
        },
        "expected": {
          "dirty": false
        },
        "split": "regression"
      }
    ],
    "minGain": 0.5
  },
  "tasks": [
    {
      "id": "transfer-new-git",
      "description": "Determine whether Git will report the tracked file dirty using the given checkout and reader settings. Return exactly {\"dirty\":boolean}.",
      "environment": "git",
      "input": {
        "kind": "git-status",
        "checkoutAutocrlf": true,
        "readerConfig": "inherit",
        "newline": "LF"
      },
      "expected": {
        "dirty": false
      }
    },
    {
      "id": "transfer-text-view",
      "description": "Determine whether the two specified views of this file will compare equal. Return exactly {\"equal\":boolean}.",
      "environment": "text",
      "input": {
        "kind": "text-view",
        "content": "供应商\r\n真实行\r\n",
        "leftView": "raw",
        "rightView": "normalize-lf"
      },
      "expected": {
        "equal": false
      }
    },
    {
      "id": "adapt-text-view",
      "description": "Determine whether the two specified views of this file will compare equal. Return exactly {\"equal\":boolean}.",
      "environment": "text",
      "input": {
        "kind": "text-view",
        "content": "供应商\n真实行\n",
        "leftView": "raw",
        "rightView": "normalize-lf"
      },
      "expected": {
        "equal": true
      }
    },
    {
      "id": "counterexample-raw",
      "description": "Determine whether the two specified views of this file will compare equal. Return exactly {\"equal\":boolean}.",
      "environment": "text",
      "input": {
        "kind": "text-view",
        "content": "供应商\r\n真实行\r\n",
        "leftView": "raw",
