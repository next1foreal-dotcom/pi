#!/bin/sh

# The real pre-commit chain lives here, in a TRACKED directory, on purpose.
#
# Husky's .husky/_ is generated by `husky install` and ships its own .gitignore
# containing "*", so it can never be committed and therefore never exists in a
# git worktree. With core.hooksPath pointing at .husky/_ , git finds no hook in
# a worktree and the entire chain below silently no-ops with exit 0 -- no error,
# no warning. Dispatch executors (and self-mod) commit from worktrees, so that
# hole disabled every gate exactly where it mattered most. Measured 2026-08-12:
# a 10-file commit including three anchor paths sailed through wt-rsi-s0.
#
# A tracked hooks dir is present in every checkout by construction, which is why
# Her-repo already does it this way. Do not move this back under .husky/ .
# .husky/pre-commit delegates here so both hooksPath settings work.
# See Her-repo docs/adr/0002 (Revised 2026-08-12, twice).

# Get list of staged files before running check
STAGED_FILES=$(git diff --cached --name-only)

git diff --cached --name-only -z | node --experimental-strip-types .githooks/anchor-path-gate.ts
if [ $? -ne 0 ]; then
  exit 1
fi

node scripts/check-lockfile-commit.mjs
if [ $? -ne 0 ]; then
  exit 1
fi

# Run the check script (formatting, linting, and type checking)
echo "Running formatting, linting, and type checking..."
npm run check
if [ $? -ne 0 ]; then
  echo "❌ Checks failed. Please fix the errors before committing."
  exit 1
fi

RUN_BROWSER_SMOKE=0
for file in $STAGED_FILES; do
  case "$file" in
    packages/ai/*|packages/web-ui/*|package.json|package-lock.json)
      RUN_BROWSER_SMOKE=1
      break
      ;;
  esac
done

if [ $RUN_BROWSER_SMOKE -eq 1 ]; then
  echo "Running browser smoke check..."
  npm run check:browser-smoke
  if [ $? -ne 0 ]; then
    echo "❌ Browser smoke check failed."
    exit 1
  fi
fi

# Restage files that were previously staged and may have been modified by formatting
for file in $STAGED_FILES; do
  if [ -f "$file" ]; then
    git add "$file"
  fi
done

echo "✅ All pre-commit checks passed!"
