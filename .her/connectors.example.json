{
  "version": 1,
  "connectors": [
    {
      "slug": "github",
      "label": "GitHub",
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "$HER_CONNECTOR_GITHUB_TOKEN"
      }
    },
    {
      "slug": "filesystem",
      "label": "本地文件目录",
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "C:/path/to/read-only-directory"],
      "env": {
        "EXAMPLE_TOKEN": "$HER_CONNECTOR_FILESYSTEM_TOKEN"
      }
    }
  ]
}
